# Copy to .env for local development. Never commit the real .env file.
DEBUG=True
SECRET_KEY=generate-a-50-plus-character-random-secret-with-many-character-types
ALLOWED_HOSTS=localhost,127.0.0.1
DEPLOYMENT_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5173
# Production: exact browser storefront origins only (comma separated); do not
# use * when requests include cookies.
STOREFRONT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_COOKIE_SAMESITE=Lax
TRUST_PROXY_SSL_HEADER=True

# Production only: Memcached must be reachable by every application worker.
MEMCACHED_LOCATION=127.0.0.1:11211

DB_NAME=mittycol
DB_USER=mittycol
DB_PASSWORD=BADSHA@28L
DB_HOST=127.0.0.1
DB_PORT=3306

GOOGLE_CLIENT_ID=your-google-oauth-client-id
# Google OAuth and SMTP are separate credentials. For a temporary Mailtrap
# Email Sandbox setup, uncomment EMAIL_PROVIDER and fill in the credentials
# shown in Mailtrap. For Mailtrap Email Sending, use that domain's SMTP host.
# Never commit SMTP passwords to the repository.
EMAIL_PROVIDER=smtp
# EMAIL_PROVIDER=mailtrap
# MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
# MAILTRAP_SMTP_PORT=2525
# MAILTRAP_SMTP_USERNAME=your-mailtrap-username
# MAILTRAP_SMTP_PASSWORD=your-mailtrap-password
# MAILTRAP_FROM_EMAIL=no-reply@example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-sender@example.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-sender@example.com
ORDER_NOTIFICATION_EMAIL=owner@example.com
EMAIL_TIMEOUT=20
PASSWORD_RESET_TIMEOUT=3600
# Cashfree Payments. Keep these values on the backend only.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=app_id_replace_me
CASHFREE_CLIENT_SECRET=secret_key_replace_me
# Cashfree order currency for the current storefront/test configuration.
CASHFREE_ORDER_CURRENCY=INR
# Public URL Cashfree can call, for example:
# https://your-backend-domain.example/backend/payment/cashfree-webhook/
CASHFREE_WEBHOOK_URL=https://your-backend-domain.example/backend/payment/cashfree-webhook/

# Razorpay Standard Checkout test mode. Keep the secret on the backend only.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
RAZORPAY_ORDER_CURRENCY=INR

# Prodinent Partner API. Keep the bearer key on the backend only. Leave live
# writes disabled until the integration has passed a controlled test.
PRODINENT_ENABLED=false
PRODINENT_BASE_URL=https://api.prodinent.com/api/v1
PRODINENT_CONNECTION_KEY=pb_live_replace_me
PRODINENT_WAREHOUSE_ID=6afc47af410ba7399915103f
PRODINENT_TIMEOUT=15
PRODINENT_LIVE_WRITES_ENABLED=false
PRODINENT_AUTO_ASSIGN_BARCODE=false
PRODINENT_AUTO_BOOK_SHIPMENT=false
PRODINENT_WEBHOOK_SECRET=replace_with_webhook_secret

# India Post Parcel (Retail) delivery quotes.  Origin is the merchant dispatch
# address; destination is taken from the customer's selected address.
INDIA_POST_ORIGIN_PINCODE=670353
INDIA_POST_ORIGIN_STATE=Kerala
INDIA_POST_PINCODE_API_URL=https://api.cept.gov.in/CommonFacilityMaster/api/values/Pincode
PINCODE_STATE_FALLBACK_API_URL=https://api.postalpincode.in/pincode/{pincode}
INDIA_POST_PINCODE_API_REQUIRED=false
INDIA_POST_DEFAULT_ITEM_WEIGHT_GRAMS=500
# Leave 0 until the applicable GST treatment is confirmed for the merchant.
INDIA_POST_GST_RATE=0
INDIA_POST_ESTIMATED_DELIVERY=4-5 business days
# Set the exact owner dispatch coordinates from Google Maps.
# INDIA_POST_ORIGIN_LATITUDE=12.000000
# INDIA_POST_ORIGIN_LONGITUDE=75.000000
INDIA_POST_FREE_DELIVERY_RADIUS_KM=5

# Direct India Post tariff API (leave disabled until the production account,
# service type, packed parcel dimensions, and dispatch coordinates are verified).
INDIA_POST_DIRECT_TARIFF_ENABLED=false
INDIA_POST_API_BASE_URL=https://app.indiapost.gov.in/beextcustomer/v1
INDIA_POST_API_USERNAME=
INDIA_POST_API_PASSWORD=
INDIA_POST_API_TIMEOUT=12
# Use business_parcel (BP) or speed_post (SP), as approved for the contract.
INDIA_POST_TARIFF_SERVICE=
INDIA_POST_PARCEL_LENGTH_CM=
INDIA_POST_PARCEL_WIDTH_CM=
INDIA_POST_PARCEL_HEIGHT_CM=
